---
// Navbar.astro - Header & Navigasi Utama
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Brand Logo BPCareU Store -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-bpRed-700 via-bpRed-800 to-bpRed-950 flex items-center justify-center text-white shadow-md shadow-bpRed-900/20 group-hover:scale-105 transition-transform">
          <span class="font-black text-xl tracking-tighter text-amber-300">BP</span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-black text-xl tracking-tight text-slate-900">BPCare<span class="text-bpRed-700">U</span></span>
            <span class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-red-100 text-bpRed-800">Store</span>
          </div>
          <p class="text-[10px] text-slate-400 font-semibold tracking-wide">Official Wellness BP Group</p>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-600">
        <a href="#katalog" class="hover:text-bpRed-700 transition-colors">Produk</a>
        <a href="#paket-harga" class="hover:text-bpRed-700 transition-colors flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-bpRed-600 animate-ping"></span>
          Kemitraan
        </a>
        <a href="#kalkulator" class="hover:text-bpRed-700 transition-colors">Kalkulator</a>
        <a href="#keunggulan" class="hover:text-bpRed-700 transition-colors">Keunggulan</a>
        <a href="#legalitas" class="hover:text-bpRed-700 transition-colors">Legalitas</a>
        <a href="#faq" class="hover:text-bpRed-700 transition-colors">FAQ</a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Tombol Akses Admin Dashboard -->
        <button id="adminPortalBtn" class="h-10 px-3.5 sm:px-4 rounded-xl border border-slate-200 hover:border-slate-800 hover:bg-slate-900 hover:text-white text-slate-700 transition-all inline-flex items-center justify-center gap-2 text-xs font-bold group shadow-2xs cursor-pointer" title="Panel Admin Database Google Sheets">
          <i class="fa-solid fa-lock text-slate-500 group-hover:text-amber-300 transition-colors"></i>
          <span>Admin</span>
        </button>

        <!-- Tombol Keranjang Belanja -->
        <button id="cartBtn" class="relative h-10 px-3.5 sm:px-4 rounded-xl border border-slate-200 hover:border-bpRed-600 hover:bg-red-50/50 text-slate-700 transition-all inline-flex items-center justify-center gap-2 text-xs font-bold group shadow-2xs cursor-pointer">
          <i class="fa-solid fa-cart-shopping text-bpRed-700 text-sm group-hover:scale-110 transition-transform"></i>
          <span>Keranjang</span>
          <span id="cartCountBadge" class="absolute -top-1.5 -right-1.5 bg-bpGold-500 text-slate-950 font-black text-[10px] w-5 h-5 rounded-full flex items-center justify-center ring-2 ring-white shadow-xs">0</span>
        </button>

        <!-- Tombol Daftar Agen -->
        <a href="#paket-harga" class="h-10 px-3.5 sm:px-4 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-bold text-xs shadow-md shadow-bpRed-800/20 border border-bpRed-700 hover:border-bpRed-800 transition-all inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-id-card-clip text-amber-300 text-sm"></i>
          <span>Daftar Agen</span>
        </a>
      </div>

    </div>
  </div>
</header>
