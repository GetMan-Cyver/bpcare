---
// FAQ.astro - Pertanyaan Umum (FAQ)
const faqs = [
  {
    index: 1,
    question: 'Berapa lama khasiat British Propolis biasanya mulai terasa?',
    answer: 'Umumnya konsumen mulai merasakan perubahan stamina dan imunitas dalam 21 hari dengan konsumsi rutin sesuai anjuran takaran berat badan.'
  },
  {
    index: 2,
    question: 'Apakah produk-produk ini boleh dicampur dalam satu paket kemitraan?',
    answer: 'Ya, seluruh paket kemitraan (Family 3 pcs, Agent 5 pcs, Agent Plus 10 pcs, dst.) memperbolehkan Anda mencampur varian resmi BP Group (BP Reguler, BP Kids, Steffi, Brassic Eye, Brassic Pro, atau BP Norway).'
  },
  {
    index: 3,
    question: 'Bagaimana cara membedakan produk British Propolis Asli vs Palsu?',
    answer: 'Produk asli memiliki segel hologram berlogo British Propolis, botol kaca gelap pekat, tulisan emboss di kemasan, nomor registrasi POM TR resmi yang dapat dicek di cekbpom.pom.go.id, dan dijual dengan harga resmi yang seragam.'
  }
];
---
<section id="faq" class="py-16 bg-slate-50 border-t border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-2">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Pertanyaan Umum (FAQ)</h2>
      <p class="text-xs sm:text-sm text-slate-500">Hal yang sering ditanyakan seputar produk dan kemitraan BP Group</p>
    </div>

    <div class="space-y-3" id="faqAccordion">
      {faqs.map((f) => (
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
          <button data-faq-index={f.index} class="faq-toggle-btn w-full p-4 sm:p-5 text-left font-bold text-xs sm:text-sm text-slate-800 flex justify-between items-center gap-4 hover:bg-slate-50 cursor-pointer">
            <span>{f.question}</span>
            <i id={`faqIcon-${f.index}`} class="fa-solid fa-chevron-down text-bpRed-700 transition-transform"></i>
          </button>
          <div id={`faqAnswer-${f.index}`} class="faq-answer-panel hidden px-5 pb-5 text-xs text-slate-600 leading-relaxed border-t border-slate-100 pt-3">
            {f.answer}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
