---
// TrustBadges.astro - Jaminan Keaslian, Legalitas BPOM & Halal
---
<section id="legalitas" class="py-10 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      
      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid fa-building-columns"></i>
        </div>
        <div>
          <span class="text-xs font-extrabold text-slate-900 block">BPOM RI Resmi</span>
          <span class="text-[11px] text-slate-500 block leading-tight">POM TR 183610771</span>
          <a href="https://cekbpom.pom.go.id" target="_blank" rel="noopener noreferrer" class="text-[10px] text-bpRed-700 font-bold hover:underline inline-flex items-center gap-1 mt-0.5">
            Cek Portal BPOM <i class="fa-solid fa-arrow-up-right-from-square text-[8px]"></i>
          </a>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid fa-moon"></i>
        </div>
        <div>
          <span class="text-xs font-extrabold text-slate-900 block">Halal MUI & Kemenag</span>
          <span class="text-[11px] text-slate-500 block leading-tight">Sertifikat Resmi</span>
          <span class="text-[10px] text-emerald-700 font-bold mt-0.5 block">100% Non-Alkohol</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-red-100 text-bpRed-800 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid fa-flask-vial"></i>
        </div>
        <div>
          <span class="text-xs font-extrabold text-slate-900 block">Formulasi Inggris</span>
          <span class="text-[11px] text-slate-500 block leading-tight">Bridgwater, United Kingdom</span>
          <span class="text-[10px] text-bpRed-700 font-bold mt-0.5 block">Standar Eropa GMP</span>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl shrink-0">
          <i class="fa-solid fa-hand-holding-heart"></i>
        </div>
        <div>
          <span class="text-xs font-extrabold text-slate-900 block">Herbal Alami Murni</span>
          <span class="text-[11px] text-slate-500 block leading-tight">Ekstrak Lebah Pilihan</span>
          <span class="text-[10px] text-amber-700 font-bold mt-0.5 block">Aman & Teruji Klinis</span>
        </div>
      </div>

    </div>
  </div>
</section>
