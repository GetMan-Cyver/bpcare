---
// ProductCatalog.astro - Katalog Produk Resmi BP Group
import { INITIAL_PRODUCTS } from '../data/products';
import { formatIDR } from '../utils/cart';

const products = INITIAL_PRODUCTS;
---
<section id="katalog" class="py-16 sm:py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
      <span class="inline-block px-3.5 py-1 rounded-full bg-bpRed-100 text-bpRed-900 text-xs font-black uppercase tracking-wider">
        Katalog Resmi BP Group
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Pilihan Varian Produk Kesehatan
      </h2>
      <p class="text-xs sm:text-sm text-slate-600">
        Klik pada kartu produk untuk melihat <strong>manfaat lengkap, nomor registrasi BPOM, aturan pakai,</strong> dan melakukan pemesanan.
      </p>

      <!-- Kategori Filter -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-4" id="categoryFilterContainer">
        <button data-filter="all" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-bpRed-800 text-white shadow-sm cursor-pointer">
          Semua Produk
        </button>
        <button data-filter="propolis" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 cursor-pointer">
          British Propolis
        </button>
        <button data-filter="stevia" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 cursor-pointer">
          Steffi Stevia
        </button>
        <button data-filter="specialty" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 cursor-pointer">
          Brassic & Norway
        </button>
      </div>
    </div>

    <!-- Grid Kartu Produk -->
    <div id="productGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((p) => (
        <div data-product-id={p.id} data-category={p.category} class="product-card bg-white rounded-3xl p-5 border border-slate-200 hover:border-bpRed-600 shadow-2xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between group cursor-pointer relative">
          <div>
            <!-- Badge & Volume -->
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-bpRed-100 text-bpRed-800">
                {p.badge || 'BP Group'}
              </span>
              <span class="text-[11px] font-semibold text-slate-400">
                {p.volume || '-'}
              </span>
            </div>

            <!-- Foto Produk -->
            <div class="w-full h-48 rounded-2xl bg-gradient-to-tr from-slate-50 to-red-50/30 p-4 mb-4 flex items-center justify-center overflow-hidden border border-slate-100 group-hover:scale-[1.02] transition-transform">
              <img src={p.image} alt={p.name} class="max-h-40 object-contain drop-shadow-md" loading="lazy" />
            </div>

            <div class="flex items-center gap-1.5 text-[10px] text-blue-700 font-bold mb-1">
              <i class="fa-solid fa-shield-halved text-[9px]"></i>
              <span class="font-mono">{p.bpom || '-'}</span>
            </div>

            <h3 class="font-black text-sm text-slate-900 group-hover:text-bpRed-700 transition-colors leading-snug line-clamp-1">
              {p.name}
            </h3>

            <p class="text-xs text-slate-500 line-clamp-2 mt-1 leading-relaxed">
              {p.shortDesc}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-slate-400 block font-medium">Harga Resmi:</span>
              <span class="text-base font-black text-bpRed-700">{formatIDR(p.price)}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button data-action="detail" data-product-id={p.id} class="px-3 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-slate-700 text-xs font-bold transition-all cursor-pointer" title="Detail Lengkap">
                Detail
              </button>
              <button data-action="buy" data-product-id={p.id} class="px-3 py-2 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white text-xs font-bold shadow-xs transition-all flex items-center gap-1 cursor-pointer">
                <i class="fa-solid fa-plus text-[10px]"></i> Beli
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
