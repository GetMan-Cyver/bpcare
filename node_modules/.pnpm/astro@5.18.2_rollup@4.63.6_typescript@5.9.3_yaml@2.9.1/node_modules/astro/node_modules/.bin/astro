#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/e/Programs/bp-astro/node_modules/.pnpm/astro@5.18.2_rollup@4.63.6_typescript@5.9.3_yaml@2.9.1/node_modules/astro/node_modules:/mnt/e/Programs/bp-astro/node_modules/.pnpm/astro@5.18.2_rollup@4.63.6_typescript@5.9.3_yaml@2.9.1/node_modules:/mnt/e/Programs/bp-astro/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/e/Programs/bp-astro/node_modules/.pnpm/astro@5.18.2_rollup@4.63.6_typescript@5.9.3_yaml@2.9.1/node_modules/astro/node_modules:/mnt/e/Programs/bp-astro/node_modules/.pnpm/astro@5.18.2_rollup@4.63.6_typescript@5.9.3_yaml@2.9.1/node_modules:/mnt/e/Programs/bp-astro/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../astro.js" "$@"
else
  exec node  "$basedir/../../astro.js" "$@"
fi
