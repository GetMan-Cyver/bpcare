          </div>
          <div class="space-y-1">
            <label for="formProdCategory" class="font-bold text-slate-700">Kategori <span class="text-red-500">*</span></label>
            <select id="formProdCategory" required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
              <option value="propolis">Propolis</option>
              <option value="stevia">Stevia</option>
              <option value="specialty">Brassic & Norway (Specialty)</option>
            </select>
          </div>
        </div>

        <div class="space-y-1">
          <label for="formProdName" class="font-bold text-slate-700">Nama Lengkap Produk <span class="text-red-500">*</span></label>
