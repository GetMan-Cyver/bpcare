<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BPCareU - Toko Resmi British Propolis & Produk Kesehatan BP Group</title>
  <meta name="description" content="Toko resmi produk BP Gcdroup: British Propolis Reguler, Green Kids, Steffi Stevia, Brassic Eye, Brassic Pro, dan BP Norway. 100% Original bersertifikat resmi BPOM & Halal.">

  <!-- ====================================================================
       PANDUAN LENGKAP KUSTOMISASI FAVICON BPCAREU:
       Browser membaca icon tab dari elemen <link rel="icon"> di bawah ini.
       
       PILIHAN 1 (Rekomendasi - Menggunakan File Gambar Sendiri .PNG / .ICO):
       1. Siapkan file logo Anda berukuran 32x32, 48x48, atau 64x64 piksel (contoh: favicon.png atau favicon.ico).
       2. Letakkan file tersebut di folder yang sama dengan file index.html ini.
       3. Ganti tag link di bawah menjadi:
          <link rel="icon" type="image/png" href="favicon.png">
          
       PILIHAN 2 (Menggunakan URL Gambar Online / CDN / Hosting):
       Jika gambar logo/favicon Anda sudah diunggah di server cloud/CDN:
          <link rel="icon" type="image/png" href="https://domainanda.com/assets/favicon.png">
          
       PILIHAN 3 (Bawaan Aktif - Inline Vector SVG Brand BP Resmi):
       Kode di bawah menggunakan SVG murni beresolusi tinggi (kombinasi Merah Marun BP,
       Emblem Shield, dan Tipografi Emas Premium). Tampil sangat tajam di layar Retina & Smartphone.
  ==================================================================== -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Cdefs%3E%3ClinearGradient id='bpGrad' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%23b91c1c'/%3E%3Cstop offset='60%25' stop-color='%237f1d1d'/%3E%3Cstop offset='100%25' stop-color='%23450a0a'/%3E%3C/linearGradient%3E%3ClinearGradient id='goldGrad' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%23fef08a'/%3E%3Cstop offset='50%25' stop-color='%23f59e0b'/%3E%3Cstop offset='100%25' stop-color='%23d97706'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='128' height='128' rx='28' fill='url(%23bpGrad)'/%3E%3Crect x='6' y='6' width='116' height='116' rx='22' fill='none' stroke='url(%23goldGrad)' stroke-width='3' stroke-opacity='0.6'/%3E%3Cpath d='M64 16 L104 36 L104 68 C104 92 64 112 64 112 C64 112 24 92 24 68 L24 36 Z' fill='%23991b1b' fill-opacity='0.4' stroke='url(%23goldGrad)' stroke-width='2' stroke-linejoin='round'/%3E%3Ctext x='64' y='76' font-size='46' font-family='Plus Jakarta Sans, Montserrat, Impact, Arial, sans-serif' font-weight='900' font-style='italic' fill='url(%23goldGrad)' text-anchor='middle' letter-spacing='-2' filter='drop-shadow(0px 3px 6px rgba(0,0,0,0.5))'%3EBP%3C/text%3E%3Ccircle cx='64' cy='94' r='4' fill='%23fbbf24'/%3E%3C/svg%3E">

  <!-- Apple Touch Icon untuk Bookmark di Layar Depan iPhone / iPad / Android -->
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%23991b1b'/%3E%3Ctext x='64' y='80' font-size='50' font-family='sans-serif' font-weight='900' font-style='italic' fill='%23fbbf24' text-anchor='middle'%3EBP%3C/text%3E%3C/svg%3E">

  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            bpRed: {
              50: '#fef2f2',
              100: '#fee2e2',
              600: '#dc2626',
              700: '#b91c1c',
              800: '#991b1b',
              900: '#7f1d1d',
              950: '#450a0a',
            },
            bpGold: {
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-bpRed-100 selection:text-bpRed-900 min-h-screen flex flex-col justify-between">

  <!-- TOP BAR PENGUMUMAN RESMI -->
  <div class="bg-gradient-to-r from-bpRed-950 via-bpRed-900 to-slate-900 text-white text-[11px] sm:text-xs py-2 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bpGold-500 text-slate-950 font-extrabold text-[10px]">RESMI</span>
        <span class="font-medium text-slate-200">Garansi 100% Original BP Group • Terdaftar BPOM RI & Halal MUI</span>
      </div>
      <div class="hidden md:flex items-center gap-4 text-slate-300">
        <span class="flex items-center gap-1.5"><i class="fa-solid fa-truck-fast text-bpGold-400"></i> Kirim ke Seluruh Indonesia</span>
        <span>•</span>
        <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-emerald-400"></i> Segel Hologram Asli</span>
      </div>
    </div>
  </div>

  <!-- HEADER & NAVBAR UTAMA -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">

        <!-- ====================================================================
             PANDUAN KUSTOMISASI LOGO:
             Untuk menggunakan file logo gambar, ganti isi elemen di bawah:
             Contoh:
             <a href="#" class="flex items-center gap-3">
               <img src="logo-bpcareu.png" alt="BPCareU Logo" class="h-10 w-auto">
             </a>
        ==================================================================== -->
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-bpRed-700 via-bpRed-800 to-bpRed-950 flex items-center justify-center text-white shadow-md shadow-bpRed-900/20 group-hover:scale-105 transition-transform">
            <span class="font-black text-xl tracking-tighter text-amber-300">BP</span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-black text-xl tracking-tight text-slate-900">BPCare<span class="text-bpRed-700">U</span></span>
              <span class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-red-100 text-bpRed-800">Store</span>
            </div>
            <p class="text-[10px] text-slate-400 font-semibold tracking-wide">Official Wellness BP Group</p>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-600">
          <a href="#katalog" class="hover:text-bpRed-700 transition-colors">Produk</a>
          <a href="#paket-harga" class="hover:text-bpRed-700 transition-colors flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-bpRed-600 animate-ping"></span>
            Kemitraan
          </a>
          <a href="#kalkulator" class="hover:text-bpRed-700 transition-colors">Kalkulator</a>
          <a href="#keunggulan" class="hover:text-bpRed-700 transition-colors">Keunggulan</a>
          <a href="#legalitas" class="hover:text-bpRed-700 transition-colors">Legalitas</a>
          <a href="#faq" class="hover:text-bpRed-700 transition-colors">FAQ</a>
        </nav>

        <!-- Right Action Items (Ukuran & Tata Letak Disamakan) -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          <!-- Tombol Akses Admin Dashboard -->
          <button onclick="openAdminPortal()" class="h-10 px-3.5 sm:px-4 rounded-xl border border-slate-200 hover:border-slate-800 hover:bg-slate-900 hover:text-white text-slate-700 transition-all inline-flex items-center justify-center gap-2 text-xs font-bold group shadow-2xs" title="Panel Admin Database Google Sheets">
            <i class="fa-solid fa-lock text-slate-500 group-hover:text-amber-300 transition-colors"></i>
            <span>Admin</span>
          </button>

          <!-- Tombol Keranjang Belanja -->
          <button id="cartBtn" onclick="toggleCartDrawer(true)" class="relative h-10 px-3.5 sm:px-4 rounded-xl border border-slate-200 hover:border-bpRed-600 hover:bg-red-50/50 text-slate-700 transition-all inline-flex items-center justify-center gap-2 text-xs font-bold group shadow-2xs">
            <i class="fa-solid fa-cart-shopping text-bpRed-700 text-sm group-hover:scale-110 transition-transform"></i>
            <span>Keranjang</span>
            <span id="cartCountBadge" class="absolute -top-1.5 -right-1.5 bg-bpGold-500 text-slate-950 font-black text-[10px] w-5 h-5 rounded-full flex items-center justify-center ring-2 ring-white shadow-xs">0</span>
          </button>

          <!-- Tombol Daftar Agen (dengan ikon Member) -->
          <a href="#paket-harga" class="h-10 px-3.5 sm:px-4 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-bold text-xs shadow-md shadow-bpRed-800/20 border border-bpRed-700 hover:border-bpRed-800 transition-all inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-id-card-clip text-amber-300 text-sm"></i>
            <span>Daftar Agen</span>
          </a>
        </div>

      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-gradient-to-b from-red-50/40 via-white to-slate-50 pt-10 pb-16 sm:py-20 border-b border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid lg:grid-cols-12 gap-12 items-center">

        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-bpRed-100/80 border border-bpRed-200 text-bpRed-900 text-xs font-bold">
            <i class="fa-solid fa-crown text-bpGold-500"></i>
            <span>Distributor Resmi Produk Kesehatan BP Group</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.15]">
            Solusi Kesehatan Alami <br class="hidden sm:inline">
            <span class="text-bpRed-700 underline decoration-bpGold-400 decoration-wavy decoration-2">Keluarga Indonesia</span> & Peluang Usaha
          </h1>

          <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
            Menyediakan produk original <strong>British Propolis (Reguler & Kids)</strong> dengan konsentrasi bioflavonoid 4x lebih pekat, <strong>Steffi Stevia</strong> pemanis 0 kalori, <strong>Brassic Eye</strong>, <strong>Brassic Pro</strong>, serta <strong>BP Norway Salmon Oil</strong>.
          </p>

          <!-- USP Cards Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-left">
            <div class="flex items-center gap-2.5 p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs">
              <div class="w-8 h-8 rounded-xl bg-red-100 text-bpRed-700 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-shield-virus text-sm"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 leading-tight">4x Bioflavonoid Lebah UK</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs">
              <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-leaf text-sm"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 leading-tight">Steffi Stevia 0 Kalori</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-2xl bg-white border border-slate-200/80 shadow-2xs col-span-2 sm:col-span-1">
              <div class="w-8 h-8 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-award text-sm"></i>
              </div>
              <span class="text-xs font-bold text-slate-800 leading-tight">BPOM RI & Halal MUI</span>
            </div>
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-3.5 pt-3 justify-center lg:justify-start">
            <a href="#katalog" class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-extrabold text-sm shadow-lg shadow-bpRed-800/25 transition-all text-center flex items-center justify-center gap-2">
              <i class="fa-solid fa-bag-shopping"></i>
              Lihat Katalog Produk
            </a>
            <a href="#paket-harga" class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-sm border border-slate-300 transition-all text-center flex items-center justify-center gap-2 shadow-2xs">
              <i class="fa-solid fa-tags text-bpRed-700"></i>
              Daftar Paket Kemitraan
            </a>
          </div>

          <div class="pt-2 flex items-center justify-center lg:justify-start gap-4 text-xs text-slate-500 font-medium">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-box text-emerald-600"></i> Ready Stock Fresh Batch</span>
            <span>•</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-handshake text-emerald-600"></i> Bimbingan Penjualan Reseller</span>
          </div>
        </div>

        <!-- Visual Hero Column -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-sm sm:max-w-md bg-gradient-to-b from-white to-red-50/40 p-6 rounded-3xl border border-red-100 shadow-2xl shadow-red-950/5">
            <div class="absolute -top-4 -right-4 bg-slate-900 text-white px-4 py-2.5 rounded-2xl shadow-lg flex items-center gap-2.5 z-20">
              <i class="fa-solid fa-award text-amber-400 text-lg"></i>
              <div>
                <p class="text-[9px] font-medium text-slate-300 uppercase leading-none">Standar Inggris</p>
                <p class="text-xs font-black">100% Produk Original</p>
              </div>
            </div>

            <!-- Graphic Banner Lineup -->
            <div class="py-6 flex flex-col items-center justify-center text-center">
              <div class="w-full h-56 rounded-2xl bg-gradient-to-tr from-slate-100 via-amber-50 to-red-50 p-4 border border-slate-200/80 flex items-center justify-center overflow-hidden relative group">
                <img src="https://down-id.img.susercontent.com/file/id-11134207-7r98q-luvn2ibimi4426.webp" alt="British Propolis Produk" class="max-h-48 object-contain drop-shadow-xl group-hover:scale-105 transition-transform duration-300" onerror="this.onerror=null; this.src='https://placehold.co/400x300/991b1b/ffffff?text=BP+Group+Products';">
              </div>
              <p class="text-xs font-bold text-slate-800 mt-4">Jajaran Produk Lengkap BP Group</p>
              <p class="text-[11px] text-slate-500">British Propolis • Steffi • Brassic Eye • Brassic Pro • BP Norway</p>
            </div>

            <div class="bg-white p-3.5 rounded-2xl border border-slate-200/90 shadow-2xs flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-amber-800 font-black text-sm">
                  <i class="fa-solid fa-check"></i>
                </div>
                <div>
                  <p class="text-xs font-bold text-slate-800">Konsultasi Dosis Gratis</p>
                  <p class="text-[11px] text-slate-500">Dampingan hingga terasa khasiatnya</p>
                </div>
              </div>
              <a href="#kalkulator" class="text-xs font-extrabold text-bpRed-700 bg-red-50 px-2.5 py-1.5 rounded-xl hover:bg-red-100 transition-colors">
                Hitung <i class="fa-solid fa-arrow-right text-[10px] ml-1"></i>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TRUST BADGES & LEGALITAS -->
  <section id="legalitas" class="py-10 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        
        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-building-columns"></i>
          </div>
          <div>
            <span class="text-xs font-extrabold text-slate-900 block">BPOM RI Resmi</span>
            <span class="text-[11px] text-slate-500 block leading-tight">POM TR 183610771</span>
            <a href="https://cekbpom.pom.go.id" target="_blank" rel="noopener noreferrer" class="text-[10px] text-bpRed-700 font-bold hover:underline inline-flex items-center gap-1 mt-0.5">
              Cek Portal BPOM <i class="fa-solid fa-arrow-up-right-from-square text-[8px]"></i>
            </a>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-moon"></i>
          </div>
          <div>
            <span class="text-xs font-extrabold text-slate-900 block">Halal MUI & Kemenag</span>
            <span class="text-[11px] text-slate-500 block leading-tight">Sertifikat Resmi</span>
            <span class="text-[10px] text-emerald-700 font-bold mt-0.5 block">100% Non-Alkohol</span>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-red-100 text-bpRed-800 flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-flask-vial"></i>
          </div>
          <div>
            <span class="text-xs font-extrabold text-slate-900 block">Formulasi Inggris</span>
            <span class="text-[11px] text-slate-500 block leading-tight">Bridgwater, United Kingdom</span>
            <span class="text-[10px] text-bpRed-700 font-bold mt-0.5 block">Standar Eropa GMP</span>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 flex items-center gap-3.5 hover:border-bpRed-400 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl shrink-0">
            <i class="fa-solid fa-hand-holding-heart"></i>
          </div>
          <div>
            <span class="text-xs font-extrabold text-slate-900 block">Herbal Alami Murni</span>
            <span class="text-[11px] text-slate-500 block leading-tight">Ekstrak Lebah Pilihan</span>
            <span class="text-[10px] text-amber-700 font-bold mt-0.5 block">Aman & Teruji Klinis</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- KATALOG PRODUK RESMI BP GROUP -->
  <section id="katalog" class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
        <span class="inline-block px-3.5 py-1 rounded-full bg-bpRed-100 text-bpRed-900 text-xs font-black uppercase tracking-wider">
          Katalog Resmi BP Group
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Pilihan Varian Produk Kesehatan
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Klik pada kartu produk untuk melihat <strong>manfaat lengkap, nomor registrasi BPOM, aturan pakai,</strong> dan melakukan pemesanan.
        </p>

        <!-- Kategori Filter -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-4">
          <button onclick="setProductFilter('all', this)" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-bpRed-800 text-white shadow-sm">
            Semua Produk
          </button>
          <button onclick="setProductFilter('propolis', this)" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200">
            British Propolis
          </button>
          <button onclick="setProductFilter('stevia', this)" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200">
            Steffi Stevia
          </button>
          <button onclick="setProductFilter('specialty', this)" class="prod-filter-btn px-4 py-2 rounded-xl text-xs font-extrabold transition-all bg-white text-slate-700 hover:bg-slate-100 border border-slate-200">
            Brassic & Norway
          </button>
        </div>
      </div>

      <!-- Grid Kartu Produk -->
      <div id="productGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Injected via JavaScript -->
      </div>

    </div>
  </section>

  <!-- DAFTAR HARGA PAKET KEMITRAAN BP GROUP -->
  <section id="paket-harga" class="py-16 sm:py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <span class="inline-block px-3.5 py-1 rounded-full bg-bpGold-400/20 text-amber-900 text-xs font-black uppercase tracking-wider border border-amber-300">
          Daftar Harga Resmi BP Group
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Paket Belanja & Kemitraan Reseller
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Berlaku untuk seluruh produk BP Group: <strong>British Propolis (Reguler/Kids), Steffi, Brassic Eye, Brassic Pro, dan BP Norway</strong>. Makin banyak jumlah paket, modal makin hemat dan potensi keuntungan makin besar!
        </p>
      </div>

      <!-- Tabel Paket Responsif Sesuai Referensi Gambar -->
      <div class="max-w-5xl mx-auto border-2 border-bpRed-800 rounded-3xl overflow-hidden shadow-xl bg-white">
        
        <!-- Table Header Banner -->
        <div class="bg-bpRed-800 text-white p-4 sm:p-5 text-center">
          <h3 class="text-lg sm:text-xl font-black tracking-wider uppercase">Daftar Harga Paket Kemitraan BP Group</h3>
          <p class="text-xs text-amber-200 font-semibold mt-1">British Propolis (Reg) • Steffi • Brassic Eye • Brassic Pro • Norway</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs sm:text-sm">
            <thead>
              <tr class="bg-red-50/80 text-bpRed-950 font-black border-b border-red-200 uppercase tracking-wider text-[11px] sm:text-xs">
                <th class="py-3.5 px-4 sm:px-6">Nama Paket</th>
                <th class="py-3.5 px-4 sm:px-6 text-center">Jumlah & Harga Satuan</th>
                <th class="py-3.5 px-4 sm:px-6 text-right">Total Harga</th>
                <th class="py-3.5 px-4 sm:px-6 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody id="packageTableBody" class="divide-y divide-slate-100 font-medium text-slate-800">
              <!-- Injected via JavaScript -->
            </tbody>
          </table>
