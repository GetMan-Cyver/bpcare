  <!-- ====================================================================
       MODAL 1: DETAIL LENGKAP PRODUK (MUNCUL SAAT CARD DIKLIK)
  ==================================================================== -->
  <div id="productDetailModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-5 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-3xl w-full max-w-3xl shadow-2xl overflow-hidden flex flex-col max-h-[92vh] animate-in fade-in zoom-in-95 duration-150">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 bg-gradient-to-r from-bpRed-900 via-bpRed-800 to-slate-900 text-white flex justify-between items-center shrink-0">
        <div class="flex items-center gap-2">
          <span id="detailCategoryBadge" class="px-2.5 py-0.5 rounded-full bg-amber-400 text-slate-950 font-black text-[10px] uppercase tracking-wider">BP Group</span>
          <span id="detailBadgeTag" class="text-xs text-amber-200 font-bold hidden sm:inline">Original Product</span>
        </div>
        <button onclick="closeProductDetailModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors" title="Tutup Modal">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-5 sm:p-7 overflow-y-auto space-y-5 text-xs sm:text-sm">
        <div class="grid sm:grid-cols-12 gap-6 items-start">
          
          <!-- Foto Produk -->
          <div class="sm:col-span-5 flex flex-col items-center">
            <div class="w-full aspect-square rounded-2xl bg-gradient-to-tr from-slate-50 to-red-50/50 p-4 border border-slate-200/80 flex items-center justify-center overflow-hidden shadow-2xs">
              <img id="detailImg" src="" alt="Detail Produk" class="max-h-56 object-contain drop-shadow-md">
            </div>
            <div class="mt-3 w-full p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-[11px]">
              <span class="text-slate-500">Volume / Isi:</span>
              <span id="detailVolume" class="font-extrabold text-slate-800">-</span>
            </div>
          </div>

          <!-- Keterangan & Manfaat -->
          <div class="sm:col-span-7 space-y-4">
            <div>
              <h3 id="detailTitle" class="text-lg sm:text-xl font-black text-slate-900 leading-snug">Nama Produk</h3>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="detailPrice" class="text-xl sm:text-2xl font-black text-bpRed-700">Rp 0</span>
                <span class="text-[10px] text-slate-400 font-medium">Harga Resmi</span>
              </div>
            </div>

            <!-- Izin BPOM -->
            <div class="p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-900 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-blue-700 text-sm"></i>
                <span class="font-bold">Izin Registrasi BPOM RI:</span>
              </div>
              <span id="detailBpom" class="font-mono font-black text-blue-800">-</span>
            </div>

            <!-- Deskripsi -->
            <div class="space-y-1.5">
              <h4 class="font-black text-xs uppercase tracking-wider text-slate-500">Uraian & Khasiat:</h4>
              <p id="detailDesc" class="text-slate-600 text-xs sm:text-sm leading-relaxed"></p>
            </div>

            <!-- Khasiat List -->
            <div class="space-y-1.5">
              <h4 class="font-black text-xs uppercase tracking-wider text-slate-500">Manfaat Utama:</h4>
              <ul id="detailBenefitsList" class="space-y-1 text-xs text-slate-600">
                <!-- Injected via JS -->
              </ul>
            </div>

            <!-- Aturan Pakai -->
            <div class="p-3.5 rounded-xl bg-amber-50/80 border border-amber-200/80 space-y-1 text-xs">
              <p class="font-bold text-amber-950 flex items-center gap-1.5">
                <i class="fa-solid fa-mortar-pestle text-amber-700"></i> Aturan Konsumsi / Pakai:
              </p>
              <p id="detailUsage" class="text-slate-700 leading-relaxed"></p>
            </div>
          </div>

        </div>
      </div>

      <!-- Modal Footer (Actions) -->
      <div class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
        <!-- Qty selector -->
        <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-start">
          <span class="text-xs font-bold text-slate-600">Kuantitas:</span>
          <div class="flex items-center border border-slate-300 rounded-xl bg-white overflow-hidden">
            <button onclick="changeDetailQty(-1)" class="w-8 h-8 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100">-</button>
            <input type="number" id="detailQtyInput" value="1" min="1" max="99" class="w-10 text-center text-xs font-bold text-slate-800 focus:outline-none">
            <button onclick="changeDetailQty(1)" class="w-8 h-8 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100">+</button>
          </div>
        </div>

        <!-- Buttons -->
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button onclick="addCurrentDetailToCart()" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-bpRed-700 text-bpRed-700 hover:bg-red-50 text-xs font-bold transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-cart-plus"></i> Tambah Keranjang
          </button>
          <button onclick="buyCurrentDetailWA()" class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center gap-2">
            <i class="fa-brands fa-whatsapp text-sm"></i> Beli Sekarang
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- ====================================================================
       MODAL 2: SLIDING CART DRAWER (KERANJANG BELANJA)
  ==================================================================== -->
  <div id="cartDrawerBackdrop" onclick="toggleCartDrawer(false)" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-50 hidden opacity-0 transition-opacity duration-200"></div>
  <div id="cartDrawer" class="fixed top-0 right-0 h-full w-full sm:w-96 bg-white z-50 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out">
    
    <!-- Drawer Header -->
    <div class="p-4 sm:p-5 bg-slate-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <i class="fa-solid fa-cart-shopping text-amber-400"></i>
        <h3 class="font-black text-sm">Keranjang Belanja</h3>
        <span id="drawerBadgeCount" class="text-[10px] font-black px-2 py-0.5 rounded-full bg-bpRed-700 text-white">0</span>
      </div>
      <button onclick="toggleCartDrawer(false)" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
        <i class="fa-solid fa-xmark text-sm"></i>
      </button>
    </div>

    <!-- Items List -->
    <div id="cartItemsList" class="flex-1 overflow-y-auto p-4 space-y-3">
      <!-- Injected via JavaScript -->
    </div>

    <!-- Drawer Footer -->
    <div class="p-5 border-t border-slate-200 bg-slate-50 space-y-4 shrink-0">
      <div class="space-y-1 text-xs">
        <div class="flex justify-between text-slate-500">
          <span>Subtotal:</span>
          <span id="drawerSubtotal" class="font-bold text-slate-800">Rp 0</span>
        </div>
        <div class="flex justify-between text-sm font-black text-slate-900 pt-2 border-t border-slate-200">
          <span>Total Bayar:</span>
          <span id="drawerTotal" class="text-bpRed-700 text-base font-black">Rp 0</span>
        </div>
      </div>

      <button id="openCheckoutBtn" onclick="openCheckoutModal()" disabled class="w-full py-3.5 rounded-2xl bg-bpRed-700 disabled:bg-slate-300 disabled:cursor-not-allowed hover:bg-bpRed-800 text-white font-extrabold text-xs sm:text-sm shadow-md transition-all flex items-center justify-center gap-2">
        <i class="fa-brands fa-whatsapp text-base"></i>
        <span>Lanjutkan ke Checkout WhatsApp</span>
      </button>
    </div>

  </div>

  <!-- ====================================================================
       MODAL 3: CHECKOUT MODAL FORMULIR PEMESANAN
  ==================================================================== -->
  <div id="checkoutModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-5 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-3xl w-full max-w-lg shadow-2xl overflow-hidden flex flex-col max-h-[92vh] animate-in fade-in zoom-in-95 duration-150">
      
      <div class="p-4 sm:p-5 bg-gradient-to-r from-emerald-800 to-emerald-950 text-white flex justify-between items-center shrink-0">
        <div class="flex items-center gap-2">
          <i class="fa-brands fa-whatsapp text-emerald-300 text-lg"></i>
          <div>
            <h3 class="font-black text-sm">Checkout Pesanan WhatsApp</h3>
            <p class="text-[10px] text-emerald-200">Data otomatis dirapikan untuk konfirmasi CS</p>
          </div>
        </div>
        <button onclick="closeCheckoutModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <form id="orderForm" onsubmit="handleCheckoutSubmit(event)" class="p-5 sm:p-6 overflow-y-auto space-y-4 text-xs">
        
        <!-- Honeypot Anti-Spam (Bot Trap) -->
        <div class="hidden" aria-hidden="true">
          <input type="text" id="honeypotWebsite" tabindex="-1" autocomplete="off">
        </div>

        <div class="p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 flex justify-between items-center text-xs">
          <div>
            <span class="text-slate-500 block text-[11px]">Total Tagihan Pesanan:</span>
            <span id="checkoutModalTotal" class="font-black text-emerald-900 text-sm">Rp 0</span>
          </div>
          <span id="checkoutModalItemsCount" class="bg-emerald-200/80 text-emerald-950 px-2.5 py-1 rounded-lg font-extrabold text-[11px]">0 Item</span>
        </div>

        <div class="space-y-1">
          <label for="orderName" class="font-bold text-slate-700">Nama Lengkap Pemesan <span class="text-red-500">*</span></label>
          <input type="text" id="orderName" required placeholder="Contoh: Bapak Ahmad Fauzi" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
        </div>

        <div class="space-y-1">
          <label for="orderPhone" class="font-bold text-slate-700">Nomor WhatsApp Aktif <span class="text-red-500">*</span></label>
          <input type="tel" id="orderPhone" required placeholder="Contoh: 081234567890" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
          <p id="phoneError" class="text-[10px] text-red-500 hidden font-bold">Gunakan format nomor WhatsApp Indonesia yang valid (08xx atau 628xx).</p>
        </div>

        <div class="space-y-1">
          <label for="orderAddress" class="font-bold text-slate-700">Alamat Lengkap & Kota Tujuan <span class="text-red-500">*</span></label>
          <textarea id="orderAddress" rows="2" required placeholder="Nama Jalan, Nomor Rumah, RT/RW, Kecamatan, Kota, Kode Pos" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600"></textarea>
        </div>

        <div class="space-y-1">
          <label for="orderNotes" class="font-bold text-slate-700">Catatan Khusus (Opsional)</label>
          <input type="text" id="orderNotes" placeholder="Misal: Paket Family campur 2 BP Dewasa + 1 Steffi" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
        </div>

        <div class="pt-2 border-t border-slate-200 flex items-center justify-end gap-2">
          <button type="button" onclick="closeCheckoutModal()" class="px-4 py-2.5 rounded-xl text-slate-600 font-bold hover:bg-slate-100">Batal</button>
          <button type="submit" id="submitOrderBtn" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold shadow-md transition-all flex items-center gap-2">
            <i class="fa-brands fa-whatsapp text-sm"></i> Kirim Pesanan ke WhatsApp
          </button>
        </div>

      </form>

    </div>
  </div>

  <!-- ====================================================================
       MODAL 4: LOGIN / OTENTIKASI ADMIN (DILENGKAPI ANTI-BRUTE FORCE)
  ==================================================================== -->
  <div id="adminLoginModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
      
      <div class="p-5 bg-gradient-to-r from-slate-950 to-slate-900 text-white flex justify-between items-center">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-bpRed-700 text-white flex items-center justify-center">
            <i class="fa-solid fa-user-shield text-sm"></i>
          </div>
          <div>
            <h3 class="font-black text-sm leading-tight">Admin Portal BPCareU</h3>
            <p class="text-[10px] text-slate-400">Akses Database Katalog Google Sheets</p>
          </div>
        </div>
        <button onclick="closeAdminLoginModal()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-slate-300 hover:text-white">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <form id="adminLoginForm" onsubmit="handleAdminLogin(event)" class="p-6 space-y-4 text-xs">
        <div class="space-y-1.5">
          <label for="adminApiKeyInput" class="font-bold text-slate-700 flex items-center justify-between">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-key text-amber-500"></i> Password / Secret API Key</span>
            <span class="text-[10px] text-bpRed-700 font-mono font-semibold">Default: PROPOLIS_SECRET_ADMIN_KEY_2026</span>
          </label>
          <div class="relative">
            <input type="password" id="adminApiKeyInput" required placeholder="Masukkan password admin..." class="w-full px-3.5 py-2.5 pr-10 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-900 font-mono">
            <button type="button" onclick="togglePasswordVisibility('adminApiKeyInput', 'loginEyeIcon')" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-700">
              <i id="loginEyeIcon" class="fa-regular fa-eye text-xs"></i>
            </button>
          </div>
          <div class="flex items-center justify-between text-[10px] text-slate-500 pt-0.5">
            <span>Sistem proteksi: Max 5 percobaan.</span>
            <span id="loginAttemptsBadge" class="font-bold text-slate-700">Sisa percobaan: 5</span>
          </div>
        </div>

        <!-- Pesan Error / Status Lockout Brute Force -->
        <div id="loginErrorMsg" class="hidden p-3 rounded-xl bg-red-50 text-red-700 border border-red-200 text-xs space-y-1">
          <div class="flex items-center gap-2 font-bold">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span id="loginErrorTitle">Password tidak sesuai!</span>
          </div>
          <p id="loginErrorDetail" class="text-[11px] leading-relaxed text-red-600">Periksa kembali password atau kunci API Anda.</p>
        </div>

        <!-- Banner Hitung Mundur Saat Akun Terkunci -->
        <div id="loginLockoutBanner" class="hidden p-3.5 rounded-2xl bg-amber-50 border border-amber-300 text-amber-950 text-xs space-y-1.5 animate-pulse">
          <div class="flex items-center gap-2 font-extrabold text-amber-900">
            <i class="fa-solid fa-shield-virus text-base text-amber-600"></i>
            <span>Akses Dibekukan Sementara</span>
          </div>
          <p class="text-[11px] leading-tight">Terlalu banyak percobaan gagal. Akses login dikunci selama:</p>
          <div class="font-mono font-black text-sm text-bpRed-700" id="loginLockoutTimer">60 detik</div>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" onclick="closeAdminLoginModal()" class="px-4 py-2 rounded-xl text-slate-600 font-bold hover:bg-slate-100">Batal</button>
          <button type="submit" id="adminLoginSubmitBtn" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-black disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-bold shadow-md transition-all flex items-center gap-2">
            <i class="fa-solid fa-arrow-right-to-bracket"></i> <span id="adminLoginBtnText">Masuk Dashboard</span>
          </button>
        </div>
      </form>

    </div>
  </div>

  <!-- ====================================================================
       MODAL 5: DASHBOARD ADMIN UTAMA (CRUD, DATABASE & GANTI PASSWORD)
  ==================================================================== -->
  <div id="adminDashboardModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-6 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-3xl w-full max-w-6xl shadow-2xl overflow-hidden flex flex-col max-h-[95vh] border border-slate-200">
      
      <!-- Top Navigation Bar -->
      <div class="p-4 sm:p-5 bg-slate-950 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-3 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-bpRed-700 flex items-center justify-center font-black text-amber-300 text-base">BP</div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-black text-base text-white">Dashboard Admin BPCareU</h2>
              <span id="dbStatusBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Mode Internal
              </span>
            </div>
            <p class="text-xs text-slate-400">Manajemen Katalog Produk & Keamanan Portal Terpadu</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="syncProductsFromSheets(true)" id="refreshSyncBtn" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-bold transition-all flex items-center gap-1.5 border border-slate-700">
            <i class="fa-solid fa-rotate text-xs"></i>
            <span>Sinkronkan Sheets</span>
          </button>
          <button onclick="closeAdminDashboard()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-red-700 text-slate-300 hover:text-white flex items-center justify-center transition-colors" title="Tutup Dashboard">
            <i class="fa-solid fa-xmark text-sm"></i>
          </button>
        </div>
      </div>

      <!-- Dashboard Tabs & Actions Header -->
      <div class="px-5 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 shrink-0">
        <div class="flex flex-wrap items-center gap-2">
          <button onclick="switchAdminTab('products')" id="tabBtnProducts" class="px-4 py-2 rounded-xl text-xs font-black bg-white border border-slate-200 text-slate-900 shadow-2xs flex items-center gap-2">
            <i class="fa-solid fa-boxes-stacked text-bpRed-700"></i> Katalog Produk (<span id="adminProductCount">0</span>)
          </button>
          <button onclick="switchAdminTab('security')" id="tabBtnSecurity" class="px-4 py-2 rounded-xl text-xs font-black text-slate-600 hover:bg-slate-200 transition-colors flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-bpRed-700"></i> Keamanan & Ganti Password
          </button>
          <button onclick="switchAdminTab('config')" id="tabBtnConfig" class="px-4 py-2 rounded-xl text-xs font-black text-slate-600 hover:bg-slate-200 transition-colors flex items-center gap-2">
            <i class="fa-solid fa-sliders text-slate-600"></i> Konfigurasi Google Sheets
          </button>
        </div>

        <div id="productTabActions" class="flex items-center gap-2">
          <button onclick="openProductForm('create')" class="px-4 py-2 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white text-xs font-bold shadow-xs transition-all flex items-center gap-1.5">
            <i class="fa-solid fa-plus text-xs"></i> Tambah Produk Baru
          </button>
        </div>
      </div>

      <!-- TAB 1: PRODUCT LIST & CRUD TABLE -->
      <div id="adminTabContentProducts" class="flex-1 overflow-y-auto p-4 sm:p-6">
        <div class="border border-slate-200 rounded-2xl overflow-hidden shadow-2xs bg-white">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-100/90 text-slate-700 font-black border-b border-slate-200 uppercase tracking-wider text-[11px]">
                  <th class="py-3 px-4">Produk</th>
                  <th class="py-3 px-4">Kategori & Volume</th>
                  <th class="py-3 px-4">Nomor BPOM</th>
                  <th class="py-3 px-4 text-right">Harga Resmi</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4 text-center">Aksi CRUD</th>
                </tr>
              </thead>
              <tbody id="adminProductTableBody" class="divide-y divide-slate-100 font-medium">
                <!-- Injected via JavaScript -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 2: KEAMANAN & GANTI PASSWORD ADMIN -->
      <div id="adminTabContentSecurity" class="flex-1 overflow-y-auto p-4 sm:p-6 hidden space-y-6">
        <div class="max-w-4xl space-y-6 text-xs">
          
          <!-- Banner Informasi Status Keamanan -->
          <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 flex items-start gap-3 text-amber-950">
            <div class="w-8 h-8 rounded-xl bg-amber-200 flex items-center justify-center text-amber-900 shrink-0">
              <i class="fa-solid fa-key"></i>
            </div>
            <div class="space-y-1">
              <h4 class="font-extrabold text-sm">Pembaruan Password Akses Admin</h4>
              <p class="leading-relaxed text-amber-900">
                Password admin berfungsi sebagai <strong>Secret API Key</strong> untuk mengamankan operasi CRUD produk dan integrasi Google Apps Script. Pastikan password baru mudah diingat oleh Anda atau tim pengelola toko.
              </p>
            </div>
          </div>

          <div class="grid lg:grid-cols-12 gap-6 items-start">
            
            <!-- Form Ganti Password -->
            <div class="lg:col-span-5 bg-white p-5 rounded-2xl border border-slate-200 space-y-4 shadow-2xs">
              <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                <i class="fa-solid fa-lock text-bpRed-700"></i>
                <h4 class="font-black text-sm text-slate-900">Formulir Ubah Password</h4>
              </div>

              <form id="changePasswordForm" onsubmit="handleChangePassword(event)" class="space-y-3.5">
                <div class="space-y-1">
                  <label for="currentAdminPass" class="font-bold text-slate-700">Password Saat Ini <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <input type="password" id="currentAdminPass" required placeholder="Masukkan password aktif" class="w-full px-3 py-2 pr-9 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600 font-mono">
                    <button type="button" onclick="togglePasswordVisibility('currentAdminPass', 'curPassEye')" class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-700">
                      <i id="curPassEye" class="fa-regular fa-eye text-xs"></i>
                    </button>
                  </div>
                </div>

                <div class="space-y-1">
                  <label for="newAdminPass" class="font-bold text-slate-700">Password Baru <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <input type="password" id="newAdminPass" required placeholder="Minimal 6 karakter" minlength="6" class="w-full px-3 py-2 pr-9 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600 font-mono">
                    <button type="button" onclick="togglePasswordVisibility('newAdminPass', 'newPassEye')" class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-700">
                      <i id="newPassEye" class="fa-regular fa-eye text-xs"></i>
                    </button>
                  </div>
                  <p class="text-[10px] text-slate-400">Gunakan kombinasi huruf & angka untuk keamanan lebih baik.</p>
                </div>

                <div class="space-y-1">
                  <label for="confirmNewAdminPass" class="font-bold text-slate-700">Konfirmasi Password Baru <span class="text-red-500">*</span></label>
                  <div class="relative">
                    <input type="password" id="confirmNewAdminPass" required placeholder="Ulangi password baru" minlength="6" class="w-full px-3 py-2 pr-9 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600 font-mono">
                    <button type="button" onclick="togglePasswordVisibility('confirmNewAdminPass', 'confirmPassEye')" class="absolute right-2.5 top-2 text-slate-400 hover:text-slate-700">
                      <i id="confirmPassEye" class="fa-regular fa-eye text-xs"></i>
                    </button>
                  </div>
                </div>

                <div id="changePassError" class="hidden p-2.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold"></div>
                <div id="changePassSuccess" class="hidden p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold"></div>

                <div class="pt-2">
                  <button type="submit" id="savePasswordBtn" class="w-full py-2.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-extrabold shadow-sm transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-floppy-disk"></i> Simpan Password Baru
                  </button>
                </div>
              </form>
            </div>

            <!-- Tabel Kredensial & Status Akses -->
            <div class="lg:col-span-7 space-y-4">
              <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-2xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <div class="flex items-center gap-2">
                    <i class="fa-solid fa-table-list text-bpRed-700"></i>
                    <h4 class="font-black text-sm text-slate-900">Tabel Informasi Kredensial Admin</h4>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Sesi Terautentikasi
                  </span>
                </div>

                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse text-xs">
                    <thead>
                      <tr class="bg-slate-50 text-slate-600 font-black border-b border-slate-200 uppercase tracking-wider text-[10px]">
                        <th class="py-2.5 px-3">Role / Peran</th>
                        <th class="py-2.5 px-3">Status Kunci</th>
                        <th class="py-2.5 px-3">Kunci Akses Aktif</th>
                        <th class="py-2.5 px-3">Terakhir Diperbarui</th>
                      </tr>
                    </thead>
                    <tbody id="credentialTableBody" class="divide-y divide-slate-100">
                      <!-- Diisi via JavaScript -->
                    </tbody>
                  </table>
                </div>

                <!-- Status Proteksi Anti-Brute Force -->
                <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-2 text-[11px] text-slate-600">
                  <div class="flex items-center justify-between font-bold text-slate-800">
                    <span class="flex items-center gap-1.5 text-emerald-700">
                      <i class="fa-solid fa-shield-halved"></i> Proteksi Anti-Brute Force Aktif
                    </span>
                    <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px]">Aktif (Max 5x)</span>
                  </div>
                  <p class="leading-relaxed">
                    Setiap percobaan login yang gagal dicatat dan dibatasi maksimal 5 kali berturut-turut. Jika terlampaui, IP/browser dibekukan selama 60 detik secara otomatis untuk menangkal serangan penebakan kata sandi.
                  </p>
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- TAB 3: GOOGLE APPS SCRIPT DATABASE CONFIG -->
      <div id="adminTabContentConfig" class="flex-1 overflow-y-auto p-4 sm:p-6 hidden space-y-6">
        <div class="max-w-3xl space-y-4 text-xs">
          <div class="bg-blue-50/70 border border-blue-200 rounded-2xl p-4 text-blue-950 space-y-2">
            <div class="flex items-center gap-2 font-bold text-sm">
              <i class="fa-solid fa-circle-info text-blue-600"></i>
              <span>Petunjuk Menghubungkan Google Sheets via Apps Script</span>
            </div>
            <p class="leading-relaxed text-slate-600">
              Database backend menggunakan file <code>google_apps_script_backend.js</code>. Masukkan URL Web App hasil deploy Anda agar seluruh operasi CRUD tersimpan otomatis ke lembar spreadsheet Anda.
            </p>
          </div>

          <form id="gasConfigForm" onsubmit="saveDatabaseConfig(event)" class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4 shadow-2xs">
            <div class="space-y-1.5">
              <label for="configWebAppUrl" class="font-bold text-slate-700 flex items-center gap-1.5">
                <i class="fa-solid fa-link text-emerald-600"></i> Google Apps Script Web App URL:
              </label>
              <input type="url" id="configWebAppUrl" placeholder="https://script.google.com/macros/s/AKfycb.../exec" class="w-full font-mono px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
              <span class="text-[10px] text-slate-500">Pastikan URL berakhiran <code>/exec</code> saat deploy sebagai Web App.</span>
            </div>

            <div class="space-y-1.5">
              <label for="configApiKey" class="font-bold text-slate-700 flex items-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-amber-500"></i> Admin Secret API Key:
              </label>
              <input type="text" id="configApiKey" placeholder="PROPOLIS_SECRET_ADMIN_KEY_2026" class="w-full font-mono px-3.5 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-bpRed-600">
              <span class="text-[10px] text-slate-500">Harus sama dengan konstanta <code>CONFIG.ADMIN_API_KEY</code> di Google Apps Script.</span>
            </div>

            <div class="pt-2 flex items-center gap-3">
              <button type="submit" class="px-5 py-2.5 rounded-xl bg-bpRed-700 hover:bg-bpRed-800 text-white font-bold shadow-md transition-all flex items-center gap-2">
                <i class="fa-solid fa-floppy-disk"></i> Simpan Konfigurasi
              </button>
              <button type="button" onclick="testDatabaseConnection()" class="px-4 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold transition-all flex items-center gap-2">
                <i class="fa-solid fa-bolt text-amber-500"></i> Uji Koneksi Database
              </button>
            </div>
          </form>

          <div id="connectionStatusResult" class="hidden p-4 rounded-2xl border text-xs"></div>
        </div>
      </div>

      <!-- Dashboard Footer -->
