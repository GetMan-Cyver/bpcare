  <div id="productFormModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-6 hidden opacity-0 transition-opacity duration-200">
    <div class="bg-white rounded-3xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
      
      <div class="p-4 sm:p-5 bg-gradient-to-r from-bpRed-800 to-red-700 text-white flex justify-between items-center shrink-0">
